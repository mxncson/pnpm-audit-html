<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>PNPM Audit Report</title>
    <meta name="description" content="<%= vulnerabilities.total %> overall vulnerabilities found." />

    <style><%- css %></style>
    <style>
        .collapsible-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.25s ease-out;
        }

        .collapsible-header {
            cursor: pointer;
        }

        .collapsible-header::after {
            content: " ▼";
        }

        .collapsible-header.active::after {
            content: " ▲";
        }

        .collapsible-content.active {
            max-height: 1000px;
        }

        .vulnerability-summary {
            margin-top: 20px;
            font-size: 1.2rem;
            text-align: center;
        }

        .vulnerability-summary .badge {
            margin-right: 10px;
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .references, .reasons {
            margin-top: 20px;
        }

        .references ul, .reasons ul {
            list-style: none;
            padding-left: 0;
        }

        .references ul li, .reasons ul li {
            padding-left: 20px;
            position: relative;
        }

        .references ul li:before, .reasons ul li:before {
            content: "•";
            position: absolute;
            left: 0;
            color: currentColor;
        }
    </style>
</head>
<body>
    <%
    const severityBadge = {
        critical: 'danger',
        high: 'warning',
        moderate: 'info',
        low: 'success',
        info: 'secondary',
    };
    const badgeClass = (severity) => severityBadge[severity] || 'secondary';
    %>
    <div class="container">
        <div class="row my-3">
            <div class="col-md text-center">
                <h1 class="h2">PNPM Audit Report</h1>
                <h3 class="h5">
                    <%= advisories.length %> unique from <%= vulnerabilities.total %> overall vulnerabilities | <%= dependencies.total %> dependencies
                </h3>
                <div class="vulnerability-summary">
                    <a href="#critical" class="badge bg-<%= badgeClass('critical') %>">Critical: <%= vulnerabilities.critical %></a>
                    <a href="#high" class="badge bg-<%= badgeClass('high') %>">High: <%= vulnerabilities.high %></a>
                    <a href="#moderate" class="badge bg-<%= badgeClass('moderate') %>">Moderate: <%= vulnerabilities.moderate %></a>
                    <a href="#low" class="badge bg-<%= badgeClass('low') %>">Low: <%= vulnerabilities.low %></a>
                    <a href="#info" class="badge bg-<%= badgeClass('info') %>">Info: <%= vulnerabilities.info %></a>
                </div>
            </div>
        </div>
        <div class="row">
            <% advisories.forEach(function(advisory, index) { %>
            <div class="col-md-12"<% if (index === 0 || advisories[index - 1].severity !== advisory.severity) { %> id="<%= advisory.severity %>"<% } %>>
                <div class="card mb-3">
                    <div class="card-body p-4">
                        <h1 class="card-title h3">
                            <span class="badge text-capitalize bg-<%= badgeClass(advisory.severity) %>">
                                <%= advisory.severity %>
                            </span>
                            <%= advisory.title %>
                        </h1>
                        <div class="row">
                            <div class="col-md-6">
                                <ul>
                                    <li>Module: <a href="https://npmjs.com/package/<%= advisory.moduleName %>" target="_blank" rel="noopener noreferrer"><%= advisory.moduleName %></a></li>
                                    <% if (advisory.installedVersions.length > 0) { %>
                                    <li>Installed version<%= advisory.installedVersions.length > 1 ? 's' : '' %>: <%= advisory.installedVersions.join(', ') %></li>
                                    <% } %>
                                    <li>Vulnerable versions: <%= advisory.vulnerableVersions %></li>
                                    <li>Patched in: <%= advisory.patchedVersions %></li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul>
                                    <% if (advisory.created) { %>
                                    <li>Published: <%= new Date(advisory.created).toISOString().slice(0, 10) %></li>
                                    <% } %>
                                    <% if (advisory.cves.length > 0) { %>
                                    <li>CVEs: <%= advisory.cves.join(', ') %></li>
                                    <% } %>
                                    <% if (advisory.cwe.length > 0) { %>
                                    <li>CWE: <%= advisory.cwe.join(', ') %></li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>

                        <% if (advisory.overview) { %>
                        <h3>Overview</h3>
                        <div><%- advisory.overview %></div>
                        <% } %>

                        <% if (advisory.recommendation) { %>
                        <h3>Remediation</h3>
                        <div><%- advisory.recommendation %></div>
                        <% } %>

                        <% if (advisory.references) { %>
                        <div class="references">
                            <h3 class="collapsible-header" onclick="this.classList.toggle('active'); this.nextElementSibling.classList.toggle('active');">
                                References
                            </h3>
                            <div class="collapsible-content">
                                <%- advisory.references %>
                            </div>
                        </div>
                        <% } %>

                        <% if (advisory.paths.length > 0) { %>
                        <div class="reasons">
                            <h3 class="collapsible-header" onclick="this.classList.toggle('active'); this.nextElementSibling.classList.toggle('active');">
                                Reasons this module exists
                            </h3>
                            <div class="collapsible-content">
                                <ul>
                                    <% advisory.paths.forEach(function(path) { %>
                                    <li><code><%= path %></code></li>
                                    <% }) %>
                                </ul>
                            </div>
                        </div>
                        <% } %>

                        <div class="d-flex justify-content-end mt-3">
                            <a href="<%= advisory.url %>" class="btn btn-md btn-primary" target="_blank" rel="noopener noreferrer">
                                More about this vulnerability
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <% }); %>
            <% if (advisories.length === 0) { %>
            <div class="col-md-12 alert alert-success">Congrats!!! No vulnerabilities have been found.</div>
            <% } %>

            <h6 class="col-md-12 mb-3 pb-3 text-end">Report generated at <%= new Date().toISOString() %></h6>
        </div>
    </div>
</body>
</html>
