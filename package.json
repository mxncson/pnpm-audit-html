{
  "name": "pnpm-audit-html",
  "version": "0.4.0",
  "description": "A tool to generate an HTML report from pnpm audit.",
  "main": "dist/index.js",
  "bin": {
    "pnpm-audit-html": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts}' --ignore-pattern '**/*.spec.ts'",
    "format": "prettier --write 'src/**/*.{js,ts}'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm test",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mxncson/pnpm-audit-html.git"
  },
  "keywords": [
    "pnpm",
    "audit",
    "html",
    "report",
    "security",
    "npm"
  ],
  "author": "Maxence Masson <maxencemasson.mm@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mxncson/pnpm-audit-html/issues"
  },
  "homepage": "https://github.com/mxncson/pnpm-audit-html#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "bootswatch": "^5.3.8",
    "commander": "^14.0.3",
    "ejs": "^6.0.1",
    "marked": "^15.0.12"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.1"
    }
  }
}
